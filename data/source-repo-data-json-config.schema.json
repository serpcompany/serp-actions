{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/serpcompany/serp-actions/data/source-repo-data-json-config.schema.json",
  "title": "Source repo data.json sync config",
  "type": "object",
  "additionalProperties": false,
  "required": ["fields", "app_name", "overrides"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "fields": {
      "type": "object",
      "description": "Target data.json keys and string templates. Supported tokens: {owner}, {repo}, {app_name}.",
      "additionalProperties": false,
      "required": ["github_source_repo", "serply_link", "app_name"],
      "properties": {
        "github_source_repo": {
          "type": "string",
          "pattern": "^([^{}]|\\{(owner|repo|app_name)\\})+$"
        },
        "serply_link": {
          "type": "string",
          "pattern": "^([^{}]|\\{(owner|repo|app_name)\\})+$"
        },
        "app_name": {
          "type": "string",
          "pattern": "^([^{}]|\\{(owner|repo|app_name)\\})+$"
        }
      }
    },
    "app_name": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strip_trailing_parenthetical", "ensure_video_before_downloader"],
      "properties": {
        "strip_trailing_parenthetical": {
          "type": "boolean",
          "description": "Remove a final suffix like (Browser Extension) from the README H1."
        },
        "ensure_video_before_downloader": {
          "type": "boolean",
          "description": "Turn names ending in Downloader into Video Downloader unless Video Downloader is already present."
        }
      }
    },
    "overrides": {
      "type": "object",
      "description": "Per-repo target data.json overrides keyed by owner/repo, for example serpcompany/example-downloader.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "github_source_repo": {
            "type": "string"
          },
          "serply_link": {
            "type": "string"
          },
          "app_name": {
            "type": "string"
          }
        }
      },
      "propertyNames": {
        "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
      }
    }
  }
}
